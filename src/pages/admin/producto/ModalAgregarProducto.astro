---
// src/pages/admin/producto/ModalAgregarProducto.astro
import { supabase } from "../../../lib/supabase";
// Consultamos las categorías existentes para listarlas en el selector
const { data: categorias } = await supabase.from("categorias").select("*");
---

<div
  id="modal-agregar-producto"
  class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center hidden"
>
  <div class="bg-white rounded-lg p-6 w-full max-w-md relative shadow-xl">
    <!-- Encabezado del Modal -->
    <div class="flex justify-between items-center mb-4 border-b pb-2">
      <h3 class="text-base font-semibold text-slate-800">
        Agregar Nuevo Producto
      </h3>
      <button
        type="button"
        id="btn-cerrar-x"
        class="text-slate-400 hover:text-slate-600 font-bold p-1 cursor-pointer"
      >
        ✕
      </button>
    </div>

    <!-- Formulario para Guardar en Supabase -->
    <form method="POST" enctype="multipart/form-data" class="space-y-3">
      <!-- 1. Nombre -->
      <div>
        <label class="block text-xs font-medium text-slate-700">
          Nombre del producto *
        </label>
        <input
          type="text"
          name="nombre"
          required
          placeholder="Ej. Zapatillas Urbanas"
          class="w-full border border-slate-300 rounded p-2 text-xs mt-1 outline-none focus:border-pink-500"
        />
      </div>

      <!-- 2. Categoría -->
      <div>
        <label class="block text-xs font-medium text-slate-700">
          Categoría *
        </label>
        <select
          name="categoria_id"
          required
          class="w-full border border-slate-300 rounded p-2 text-xs mt-1 outline-none focus:border-pink-500 text-slate-700"
        >
          <option value="">-- Selecciona una categoría --</option>
          {
            categorias?.map((cat) => (
              <option value={cat.id}>{cat.nombre || cat.name}</option>
            ))
          }
        </select>
      </div>

      <!-- 3. Precio y Stock -->
      <div class="grid grid-cols-2 gap-2">
        <div>
          <label class="block text-xs font-medium text-slate-700">
            Precio (S/) *
          </label>
          <input
            type="number"
            step="0.01"
            name="precio"
            required
            placeholder="0.00"
            class="w-full border border-slate-300 rounded p-2 text-xs mt-1 outline-none focus:border-pink-500"
          />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-700">
            Stock *
          </label>
          <input
            type="number"
            name="stock"
            value="0"
            required
            class="w-full border border-slate-300 rounded p-2 text-xs mt-1 outline-none focus:border-pink-500"
          />
        </div>
      </div>

      <!-- 4. Descripción -->
      <div>
        <label class="block text-xs font-medium text-slate-700">
          Descripción
        </label>
        <textarea
          name="descripcion"
          rows="2"
          placeholder="Añade detalles del producto..."
          class="w-full border border-slate-300 rounded p-2 text-xs mt-1 outline-none focus:border-pink-500"
        ></textarea>
      </div>

      <!-- 5. Campo de Selección e Imagen de Previsualización -->
      <div>
        <label class="block text-xs font-medium text-slate-700">
          Imagen del producto
        </label>
        <input
          type="file"
          id="input-imagen-modal"
          name="imagen"
          accept="image/*"
          class="w-full text-xs mt-1 text-slate-500"
        />

        <!-- 📍 CONTENEDOR DE PREVISUALIZACIÓN (OCULTO INICIALMENTE) -->
        <div
          id="contenedor-preview"
          class="mt-2 hidden relative w-24 h-24 border border-slate-200 rounded-lg overflow-hidden bg-slate-50"
        >
          <img
            id="img-preview"
            src=""
            alt="Vista previa"
            class="w-full h-full object-cover"
          />
          <button
            type="button"
            id="btn-quitar-preview"
            class="absolute top-1 right-1 bg-black/60 hover:bg-black/80 text-white rounded-full w-5 h-5 flex items-center justify-center text-[10px] cursor-pointer"
            title="Quitar imagen"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Botones de Acción y Mensaje de Éxito -->
      <div
        class="flex items-center justify-end gap-2 pt-3 border-t mt-4 relative"
      >
        <!-- Spinner de Carga -->
        <div
          id="spinner-guardar"
          class="hidden h-5 w-5 animate-spin rounded-full border-2 border-pink-600 border-t-transparent mr-2"
        >
        </div>

        <!-- 📍 NUEVO: MENSAJE DE ÉXITO (OCULTO POR DEFECTO) -->
        <div
          id="mensaje-exito"
          class="hidden text-xs font-semibold text-emerald-600 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded-md flex items-center gap-1.5"
        >
          <span>✅</span> ¡Producto ingresado con éxito!
        </div>

        <button
          type="button"
          id="btn-cancelar-modal"
          class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs rounded cursor-pointer transition-colors"
        >
          Cancelar
        </button>

        <button
          type="submit"
          id="btn-guardar-producto"
          class="px-4 py-2 bg-pink-600 hover:bg-pink-700 text-white text-xs font-medium rounded cursor-pointer transition-colors"
        >
          Guardar Producto
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // 1. CAPTURA ÚNICA DE ELEMENTOS DEL DOM
  const modal = document.getElementById("modal-agregar-producto");
  const btnCerrarX = document.getElementById("btn-cerrar-x");
  const btnCancelar = document.getElementById(
    "btn-cancelar-modal",
  ) as HTMLButtonElement | null;

  // Elementos para la Previsualización
  const inputImagen = document.getElementById(
    "input-imagen-modal",
  ) as HTMLInputElement | null;
  const contenedorPreview = document.getElementById("contenedor-preview");
  const imgPreview = document.getElementById(
    "img-preview",
  ) as HTMLImageElement | null;
  const btnQuitarPreview = document.getElementById("btn-quitar-preview");

  // Elementos del Formulario y Spinner
  const formModal = document.querySelector(
    "#modal-agregar-producto form",
  ) as HTMLFormElement | null;
  const spinner = document.getElementById("spinner-guardar");

  // 2. ESCUCHAR SEÑAL PARA ABRIR MODAL
  window.addEventListener("abrir-modal-producto", () => {
    modal?.classList.remove("hidden");
  });

  // 3. FUNCIONES PARA LIMPIAR Y CERRAR
  function resetearYCerrar() {
    limpiarPreview();
    modal?.classList.add("hidden");
  }

  function limpiarPreview() {
    if (inputImagen) inputImagen.value = "";
    if (imgPreview) imgPreview.src = "";
    contenedorPreview?.classList.add("hidden");
  }

  // 4. PREVISUALIZACIÓN DE LA IMAGEN EN TIEMPO REAL
  inputImagen?.addEventListener("change", (e) => {
    const archivo = (e.target as HTMLInputElement).files?.[0];
    if (archivo) {
      const urlTemporal = URL.createObjectURL(archivo);
      if (imgPreview) imgPreview.src = urlTemporal;
      contenedorPreview?.classList.remove("hidden");
    } else {
      limpiarPreview();
    }
  });

  // 5. ESCUCHADORES PARA BOTONES DE CIERRE
  btnQuitarPreview?.addEventListener("click", limpiarPreview);
  btnCerrarX?.addEventListener("click", resetearYCerrar);
  btnCancelar?.addEventListener("click", resetearYCerrar);

  // -------------------------------------------------------------
  // // 6. MOSTRAR SPINNER AL ENVIAR (SIN BLOQUEAR EL ENVÍO REAL)
  // -------------------------------------------------------------
  formModal?.addEventListener("submit", () => {
    // Mostramos el spinner justo cuando se presiona Guardar
    spinner?.classList.remove("hidden");
    // El formulario continúa su flujo POST normal hacia index.astro
  });
</script>
